<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="emr.AppointmentCalendarEvent">
        <div class="o_emr_cal_event_line">
            <span t-if="!isTimeHidden" class="o_emr_cal_event_time" t-esc="startTime"/>
            <span class="o_emr_cal_event_patient" t-esc="title"/>
        </div>
        <div t-if="!isMonth and rawRecord.appointment_calendar_subtitle"
             class="o_emr_cal_event_kind"
             t-esc="rawRecord.appointment_calendar_subtitle"/>
    </t>

    <t t-name="emr.AppointmentCalendarButtons">
        <div class="d-flex gap-1">
            <button type="button" class="btn btn-secondary"
                    t-on-click="() => this.openWindowAction('emr.emr_demand_book_action')">
                Demanda
            </button>
            <button type="button" class="btn btn-secondary"
                    t-on-click="() => this.openWindowAction('emr.emr_overbooking_book_action')">
                Sobreturno
            </button>
            <button type="button" class="btn btn-secondary"
                    t-on-click="() => this.openWindowAction('emr.emr_slot_filter_action')">
                Agenda
            </button>
        </div>
    </t>

    <t t-name="emr.AppointmentCalendarPopover.footer" t-inherit="web.CalendarCommonPopover.footer" t-inherit-mode="primary">
        <xpath expr="//a[hasclass('o_cw_popover_edit')]" position="before">
            <a t-if="canAttendNow" href="#"
               class="btn btn-primary o_emr_calendar_attend"
               t-on-click="onAttendNow">
                Atender ahora
            </a>
        </xpath>
    </t>

</templates>
