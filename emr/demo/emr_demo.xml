    <!-- ================================================================
         Tipos de turno

         Son plantillas de venta: definen qué se le cobra al paciente. Una
         consulta es una sola línea; un estudio suele ser un conjunto.

         El orden importa: el primero por secuencia es el que el asistente
         propone por defecto.
         ================================================================ -->

    <!-- Sin compañía: el tipo de turno es configuración de la clínica y lo
         usan todas sus compañías. Con compañía, el turno de un profesional
         que factura por su cuenta no puede aplicar la plantilla —Odoo lo
         corta por cruce de compañías. -->
    <record id="demo_tmpl_consulta" model="sale.order.template">
        <field name="company_id" eval="False"/>
        <field name="name">Consulta</field>
        <field name="is_appointment" eval="True"/>
        <field name="sequence">1</field>
    </record>
    <record id="demo_tmpl_consulta_l1" model="sale.order.template.line">
        <field name="sale_order_template_id" ref="demo_tmpl_consulta"/>
        <field name="product_id" ref="demo_product_consulta"/>
        <field name="product_uom_qty">1</field>
    </record>

    <!-- Sin compañía: el tipo de turno es configuración de la clínica y lo
         usan todas sus compañías. Con compañía, el turno de un profesional
         que factura por su cuenta no puede aplicar la plantilla —Odoo lo
         corta por cruce de compañías. -->
    <record id="demo_tmpl_control" model="sale.order.template">
        <field name="company_id" eval="False"/>
        <field name="name">Control sin cargo</field>
        <field name="is_appointment" eval="True"/>
        <field name="sequence">30</field>
    </record>
    <record id="demo_tmpl_control_l1" model="sale.order.template.line">
