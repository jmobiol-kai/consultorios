<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="emr_appointment_addon_view_form" model="ir.ui.view">
        <field name="name">emr.appointment.addon.form</field>
        <field name="model">emr.appointment.addon</field>
        <field name="arch" type="xml">
            <form string="Agregar una práctica">
                <!-- El paciente arriba y sin etiqueta, igual que al asignar:
                     el que carga esto tiene a la persona adelante. -->
                <div class="oe_title mb-3">
                    <h1><field name="partner_id" nolabel="1" readonly="1"/></h1>
                    <div class="text-muted">
                        Se suma al turno <field name="parent_order_id" nolabel="1" readonly="1" class="oe_inline"/>
                    </div>
                </div>
                <group>
                    <group>
                        <field name="sale_order_template_id"/>
                        <field name="encounter_type_id" readonly="1"
                               invisible="not encounter_type_id"/>
                    </group>
                    <group>
                        <field name="practitioner_id" options="{'no_create': True}"/>
                        <field name="location_id" options="{'no_create': True}"/>
                        <field name="appointment_start" readonly="1"/>
                    </group>
                </group>
                <field name="note" placeholder="Por qué se agregó"/>
                <footer>
                    <button name="action_add" type="object" string="Agregar y cobrar"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancelar" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="emr_appointment_addon_action" model="ir.actions.act_window">
        <field name="name">Agregar una práctica</field>
        <field name="res_model">emr.appointment.addon</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
