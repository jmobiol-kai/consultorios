<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="emr_slot_generate_view_form" model="ir.ui.view">
        <field name="name">emr.slot.generate.form</field>
        <field name="model">emr.slot.generate</field>
        <field name="arch" type="xml">
            <form string="Generar agenda">
                <group>
                    <field name="practitioner_ids" widget="many2many_tags"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Generar"
                            class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="emr_slot_generate_action" model="ir.actions.act_window">
        <field name="name">Generar agenda</field>
        <field name="res_model">emr.slot.generate</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
