<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="emr_medication_view_list" model="ir.ui.view">
        <field name="name">emr.medication.list</field>
        <field name="model">emr.medication</field>
        <field name="arch" type="xml">
            <list string="Medicamentos" editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="active_ingredient"/>
                <field name="presentation"/>
            </list>
        </field>
    </record>
    <record id="emr_medication_view_search" model="ir.ui.view">
        <field name="name">emr.medication.search</field>
        <field name="model">emr.medication</field>
        <field name="arch" type="xml">
            <search string="Medicamentos">
                <field name="name"/>
                <field name="code"/>
                <field name="active_ingredient"/>
            </search>
        </field>
    </record>
    <record id="emr_medication_action" model="ir.actions.act_window">
        <field name="name">Medicamentos</field>
        <field name="res_model">emr.medication</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
