<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="emr_demand_book_view_form" model="ir.ui.view">
        <field name="name">emr.demand.book.form</field>
        <field name="model">emr.demand.book</field>
        <field name="arch" type="xml">
            <form string="Atender por demanda">
                <group>
                    <field name="practitioner_id" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_book" type="object" string="Crear el turno"
                            class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="emr_demand_book_action" model="ir.actions.act_window">
        <field name="name">Atender por demanda</field>
        <field name="res_model">emr.demand.book</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
