<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="emr_specialty_view_list" model="ir.ui.view">
        <field name="name">emr.specialty.list</field>
        <field name="model">emr.specialty</field>
        <field name="arch" type="xml">
            <list string="Especialidades" editable="bottom">
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>
    <record id="emr_specialty_action" model="ir.actions.act_window">
        <field name="name">Especialidades</field>
        <field name="res_model">emr.specialty</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
