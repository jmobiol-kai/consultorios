<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="emr_allergy_view_list" model="ir.ui.view">
        <field name="name">emr.allergy.list</field>
        <field name="model">emr.allergy</field>
        <field name="arch" type="xml">
            <list string="Alergias" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="emr_allergy_view_search" model="ir.ui.view">
        <field name="name">emr.allergy.search</field>
        <field name="model">emr.allergy</field>
        <field name="arch" type="xml">
            <search string="Alergias">
                <field name="name"/>
            </search>
        </field>
    </record>
    <record id="emr_allergy_action" model="ir.actions.act_window">
        <field name="name">Alergias</field>
        <field name="res_model">emr.allergy</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
