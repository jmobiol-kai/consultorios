<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="emr_location_view_list" model="ir.ui.view">
        <field name="name">emr.location.list</field>
        <field name="model">emr.location</field>
        <field name="arch" type="xml">
            <list string="Locaciones" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="emr_location_action" model="ir.actions.act_window">
        <field name="name">Locaciones</field>
        <field name="res_model">emr.location</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
