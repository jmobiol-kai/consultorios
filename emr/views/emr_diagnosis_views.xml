<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="emr_diagnosis_view_list" model="ir.ui.view">
        <field name="name">emr.diagnosis.list</field>
        <field name="model">emr.diagnosis</field>
        <field name="arch" type="xml">
            <list string="Diagnósticos" editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="parent_id"/>
            </list>
        </field>
    </record>
    <record id="emr_diagnosis_view_search" model="ir.ui.view">
        <field name="name">emr.diagnosis.search</field>
        <field name="model">emr.diagnosis</field>
        <field name="arch" type="xml">
            <search string="Diagnósticos">
                <field name="name"/>
                <field name="code"/>
                <field name="parent_id"/>
            </search>
        </field>
    </record>
    <record id="emr_diagnosis_action" model="ir.actions.act_window">
        <field name="name">Diagnósticos</field>
        <field name="res_model">emr.diagnosis</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
