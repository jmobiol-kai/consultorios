<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- La grilla del profesional.

         En Odoo 19 las franjas del calendario no se editan embebidas en el
         formulario sino en su propia vista, asi que se hereda esa.

         La duracion y la locacion son de la franja y no del profesional: un
         mismo medico atiende consultorio de 15 minutos un dia y endoscopia de
         45 otro. -->
    <record id="resource_calendar_attendance_view_list_emr" model="ir.ui.view">
        <field name="name">resource.calendar.attendance.list.emr</field>
        <field name="model">resource.calendar.attendance</field>
        <field name="inherit_id" ref="resource.view_resource_calendar_attendance_tree"/>
        <field name="arch" type="xml">
            <field name="hour_to" position="after">
                <field name="slot_duration"/>
                <field name="slot_type"/>
                <field name="location_id"/>
            </field>
        </field>
    </record>

    <record id="resource_calendar_attendance_view_form_emr" model="ir.ui.view">
        <field name="name">resource.calendar.attendance.form.emr</field>
        <field name="model">resource.calendar.attendance</field>
        <field name="inherit_id" ref="resource.view_resource_calendar_attendance_form"/>
        <field name="arch" type="xml">
            <field name="hour_to" position="after">
                <field name="slot_duration"/>
                <field name="slot_type"/>
                <field name="location_id"/>
            </field>
        </field>
    </record>
</odoo>
