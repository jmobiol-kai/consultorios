<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="emr_pet_prevention_view_list" model="ir.ui.view">
        <field name="name">emr.pet.prevention.list</field>
        <field name="model">emr.pet.prevention</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="pet_id"/>
                <field name="kind"/>
                <field name="product_id"/>
                <field name="lot_id" optional="show"/>
                <field name="expiration_date" optional="show"/>
                <field name="next_date"/>
                <field name="reminder_sent" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="emr_pet_prevention_view_search" model="ir.ui.view">
        <field name="name">emr.pet.prevention.search</field>
        <field name="model">emr.pet.prevention</field>
        <field name="arch" type="xml">
            <search>
                <field name="pet_id"/>
                <field name="product_id"/>
                <filter name="vaccine" string="Vacunas" domain="[('kind', '=', 'vaccine')]"/>
                <filter name="deworming" string="Desparasitación" domain="[('kind', '=', 'deworming')]"/>
                <separator/>
                <filter name="upcoming" string="Próxima dosis"
                        domain="[('next_date', '!=', False), ('pet_id.deceased', '=', False)]"/>
                <group>
                    <filter name="group_pet" string="Mascota" context="{'group_by': 'pet_id'}"/>
                    <filter name="group_kind" string="Tipo" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="emr_pet_prevention_action" model="ir.actions.act_window">
        <field name="name">Vacunas y desparasitación</field>
        <field name="res_model">emr.pet.prevention</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="emr_pet_prevention_view_search"/>
    </record>

    <record id="emr_pet_prevention_view_form" model="ir.ui.view">
        <field name="name">emr.pet.prevention.form</field>
        <field name="model">emr.pet.prevention</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="pet_id"/>
                            <field name="kind"/>
                            <field name="product_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="lot_id"/>
                            <field name="expiration_date"/>
                            <field name="next_date"/>
                            <field name="encounter_id"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Nota"/>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
