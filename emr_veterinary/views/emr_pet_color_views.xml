<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="emr_pet_color_view_list" model="ir.ui.view">
        <field name="name">emr.pet.color.list</field>
        <field name="model">emr.pet.color</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="species_id"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="emr_pet_color_view_search" model="ir.ui.view">
        <field name="name">emr.pet.color.search</field>
        <field name="model">emr.pet.color</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="species_id"/>
                <filter name="group_species" string="Especie" context="{'group_by': 'species_id'}"/>
            </search>
        </field>
    </record>

    <record id="emr_pet_color_action" model="ir.actions.act_window">
        <field name="name">Colores</field>
        <field name="res_model">emr.pet.color</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="emr_pet_color_view_search"/>
    </record>

</odoo>
