<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rule_pet_company" model="ir.rule">
        <field name="name">Mascotas: multi-compañía</field>
        <field name="model_id" ref="model_emr_pet"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_pet_weight_company" model="ir.rule">
        <field name="name">Peso: multi-compañía</field>
        <field name="model_id" ref="model_emr_pet_weight"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_pet_prevention_company" model="ir.rule">
        <field name="name">Vacunas: multi-compañía</field>
        <field name="model_id" ref="model_emr_pet_prevention"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_vet_encounter_company" model="ir.rule">
        <field name="name">Consulta veterinaria: multi-compañía</field>
        <field name="model_id" ref="model_emr_encounter_veterinary"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_vet_encounter_own" model="ir.rule">
        <field name="name">Consulta veterinaria: las propias</field>
        <field name="model_id" ref="model_emr_encounter_veterinary"/>
        <field name="domain_force">[('practitioner_id.user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('emr.group_emr_practitioner'))]"/>
    </record>

    <record id="rule_vet_encounter_all" model="ir.rule">
        <field name="name">Consulta veterinaria: todas</field>
        <field name="model_id" ref="model_emr_encounter_veterinary"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('emr.group_emr_manager'))]"/>
    </record>

    <record id="rule_consumption_company" model="ir.rule">
        <field name="name">Consumo: multi-compañía</field>
        <field name="model_id" ref="model_emr_veterinary_consumption_line"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_prescription_company" model="ir.rule">
        <field name="name">Receta: multi-compañía</field>
        <field name="model_id" ref="model_emr_veterinary_prescription"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
