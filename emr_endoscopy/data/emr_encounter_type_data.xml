<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Los tipos que habilita este modulo. La secuencia arranca en 20 para
         quedar despues de la consulta, que la trae emr. -->
    <record id="encounter_type_colonoscopy" model="emr.encounter.type">
        <field name="summary_template">emr_endoscopy.encounter_summary_colonoscopy</field>
        <field name="name">Colonoscopía</field>
        <field name="model_name">emr.encounter.colonoscopy</field>
        <field name="report_template">emr_endoscopy.report_encounter_colonoscopy_body</field>
        <field name="sequence">20</field>
    </record>
    <record id="encounter_type_upper_endoscopy" model="emr.encounter.type">
        <field name="summary_template">emr_endoscopy.encounter_summary_upper_endoscopy</field>
        <field name="name">Endoscopía alta</field>
        <field name="model_name">emr.encounter.upper.endoscopy</field>
        <field name="report_template">emr_endoscopy.report_encounter_upper_endoscopy_body</field>
        <field name="sequence">30</field>
    </record>
    <record id="encounter_type_banding" model="emr.encounter.type">
        <field name="summary_template">emr_endoscopy.encounter_summary_banding</field>
        <field name="name">Banding</field>
        <field name="model_name">emr.encounter.banding</field>
        <field name="report_template">emr_endoscopy.report_encounter_banding_body</field>
        <field name="sequence">40</field>
    </record>
</odoo>
