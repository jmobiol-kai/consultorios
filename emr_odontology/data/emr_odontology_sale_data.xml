    </record>
    <record id="product_odontology_sealant" model="product.product">
        <field name="name">Sellador</field>
        <field name="type">service</field>
        <field name="is_medical_procedure" eval="True"/>
        <field name="odontology_condition">sealant</field>
        <field name="purchase_ok" eval="False"/>
    </record>
</odoo>
