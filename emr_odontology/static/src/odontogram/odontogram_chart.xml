<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="emr_odontology.OdontogramChart">
        <div t-att-class="props.readonly ? 'o_emr_odontogram o_emr_odontogram_readonly' : 'o_emr_odontogram'">
            <div class="o_emr_odontogram_scroll">
                <div class="o_emr_odontogram_board">
                    <div class="o_emr_odontogram_sides text-muted">
                        <span>Derecha del paciente</span>
                        <span>Izquierda del paciente</span>
                    </div>
                    <t t-foreach="jaws" t-as="jaw" t-key="jaw.key">
                        <t t-foreach="jaw.rows" t-as="row" t-key="row.key">
                            <div t-attf-class="o_emr_odontogram_archline o_emr_odontogram_row_{{ row.dentition }}">
                                <span t-attf-class="o_emr_odontogram_qnum {{ row.dentition === 'primary' ? 'o_emr_odontogram_qnum_primary' : '' }}"
                                      t-esc="row.labelRight"/>
                                <div class="o_emr_odontogram_jaw">
                                    <t t-foreach="row.sides" t-as="side" t-key="side.key">
                                        <div t-if="side_index" class="o_emr_odontogram_midline" aria-hidden="true"/>
                                        <div class="o_emr_odontogram_quadrant">
                                            <t t-foreach="side.slots" t-as="fdi" t-key="side.key + '-' + fdi_index">
                                                <div t-if="!fdi" class="o_emr_odontogram_tooth o_emr_odontogram_tooth_spacer" aria-hidden="true"/>
                                                <div t-else=""
                                                     t-att-class="conditionOfSurface(fdi, 'tooth') === 'missing' ? 'o_emr_odontogram_tooth o_emr_odontogram_tooth_missing' : 'o_emr_odontogram_tooth'">
                                                    <span class="o_emr_odontogram_pos" t-esc="positionOf(fdi)"/>
                                                    <svg viewBox="0 0 100 100" class="o_emr_odontogram_svg">
                                                        <circle cx="50" cy="50" r="47"
                                                                t-att-class="piezaClass(fdi)"
                                                                t-att-style="piezaStyle(fdi)"/>
                                                        <t t-foreach="facesFor(fdi, row.lower)" t-as="face" t-key="face.surface">
                                                            <path t-att-d="face.d"
                                                                  t-att-class="regionClass(fdi, face.surface)"
                                                                  t-att-style="regionStyle(fdi, face.surface)"
                                                                  t-att-aria-label="regionTitle(fdi, face.surface)"
                                                                  t-att-aria-pressed="isSelected(fdi, face.surface) ? 'true' : 'false'"
                                                                  t-on-click="(ev) => this.onRegion(fdi, face.surface, ev)">
                                                                <title><t t-esc="regionTitle(fdi, face.surface)"/></title>
                                                            </path>
                                                        </t>
                                                        <circle cx="50" cy="50" r="20"
                                                                t-att-class="regionClass(fdi, 'occlusal')"
                                                                t-att-style="regionStyle(fdi, 'occlusal')"
                                                                t-att-aria-label="regionTitle(fdi, 'occlusal')"
                                                                t-att-aria-pressed="isSelected(fdi, 'occlusal') ? 'true' : 'false'"
                                                                t-on-click="(ev) => this.onRegion(fdi, 'occlusal', ev)">
                                                            <title><t t-esc="regionTitle(fdi, 'occlusal')"/></title>
                                                        </circle>
                                                        <t t-foreach="faceSymbols(fdi, row.lower)" t-as="glyph" t-key="glyph.key">
                                                            <text class="o_emr_odontogram_symbol"
                                                                  t-att-x="glyph.x" t-att-y="glyph.y"
                                                                  t-att-fill="glyph.fill"
                                                                  t-esc="glyph.symbol"/>
                                                        </t>
                                                        <t t-set="center" t-value="centerSymbol(fdi)"/>
                                                        <text t-if="center"
                                                              class="o_emr_odontogram_symbol o_emr_odontogram_symbol_lg"
                                                              x="50" y="52"
                                                              t-att-fill="center.fill"
                                                              t-esc="center.symbol"/>
                                                        <g t-if="showCross(fdi)" class="o_emr_odontogram_x"
                                                           t-att-stroke="crossStroke(fdi)">
                                                            <line x1="28" y1="28" x2="72" y2="72"/>
                                                            <line x1="72" y1="28" x2="28" y2="72"/>
                                                        </g>
                                                    </svg>
                                                    <button type="button"
                                                            t-att-class="fdiClass(fdi)"
                                                            t-att-title="regionTitle(fdi, 'tooth')"
                                                            t-att-aria-pressed="isSelected(fdi, 'tooth') ? 'true' : 'false'"
                                                            t-att-disabled="props.readonly or undefined"
                                                            t-on-click="(ev) => this.onTooth(fdi, ev)"
                                                            t-esc="fdi"/>
                                                </div>
                                            </t>
                                        </div>
                                    </t>
                                </div>
                                <span t-attf-class="o_emr_odontogram_qnum {{ row.dentition === 'primary' ? 'o_emr_odontogram_qnum_primary' : '' }}"
                                      t-esc="row.labelLeft"/>
                            </div>
                        </t>
                        <div t-if="jaw.key === 'upper'" class="o_emr_odontogram_cross" aria-hidden="true"/>
                    </t>
                </div>
            </div>
            <p class="o_emr_odontogram_help text-muted" t-esc="helpLine"/>
            <p t-if="state.hint" class="o_emr_odontogram_hint" role="status" t-esc="state.hint"/>
            <div t-if="state.selection and !props.readonly" class="o_emr_odontogram_panel">
                <span class="o_emr_odontogram_panel_title" t-esc="panelTitle"/>
                <div t-if="showStateButtons" class="btn-group" role="group" aria-label="Estado">
                    <button type="button"
                            t-att-class="selectedStatus === 'pending' ? 'btn btn-sm btn-danger' : 'btn btn-sm btn-outline-danger'"
                            t-on-click="() => this.setSelectedStatus('pending')"
                            t-esc="statusName('pending')"/>
                    <button type="button"
                            t-att-class="selectedStatus === 'treated' ? 'btn btn-sm btn-primary' : 'btn btn-sm btn-outline-primary'"
                            t-on-click="() => this.setSelectedStatus('treated')"
                            t-esc="statusName('treated')"/>
                </div>
                <span t-if="selectedStatus === 'present'" class="o_emr_odontogram_panel_present text-muted">Presente</span>
                <input t-if="selectedPaintedMark()"
                       class="o_emr_odontogram_notes"
                       type="text"
                       placeholder="Nota"
                       t-att-value="selectedNotes"
                       t-on-change="(ev) => this.onSelectedNotes(ev)"/>
            </div>
            <div class="o_emr_odontogram_legend">
                <t t-foreach="legend" t-as="item" t-key="item.condition">
                    <button type="button"
                            t-att-class="legendClass(item.condition)"
                            t-att-title="legendTitle(item.condition)"
                            t-att-disabled="props.readonly or undefined"
                            t-att-aria-pressed="isLegendActive(item.condition) ? 'true' : 'false'"
                            t-on-click="() => this.onLegend(item.condition)">
                        <span class="o_emr_odontogram_legend_symbol" t-esc="symbolOf(item.condition, true) or '•'"/>
                        <t t-esc="item.label"/>
                    </button>
                </t>
            </div>
        </div>
    </t>

</templates>
