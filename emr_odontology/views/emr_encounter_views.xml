<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- El formulario hereda el de la atención en modo primario: los botones,
         la cabecera y el panel de historia se escriben una sola vez en emr. -->
    <record id="emr_encounter_odontology_view_form" model="ir.ui.view">
        <field name="name">emr.encounter.odontology.form</field>
        <field name="model">emr.encounter.odontology</field>
        <field name="inherit_id" ref="emr.emr_encounter_view_form_base"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <!-- La historia sigue al costado. La clase marca esta consulta
                 para achicar esa columna y el odontograma
                 (encounter_form.scss). -->
            <xpath expr="//field[@name='active']" position="after">
                <field name="encounter_id" invisible="1"/>
            </xpath>
            <!-- create=false saca el + Nuevo del panel. Ese botón abre otra
                 consulta vacía, sin paciente ni presupuesto, y se confunde
                 con Nuevo de la cabecera (el presupuesto). -->
            <xpath expr="//form" position="attributes">
                <attribute name="class" add="o_emr_odontology_encounter" separator=" "/>
                <attribute name="create">false</attribute>
            </xpath>
            <!-- Nuevo queda a la izquierda de Atendido. Atendido no se toca:
                 cierra la visita. Nuevo es el único que arma el presupuesto. -->
            <xpath expr="//header/button[@name='action_close']" position="before">
                <button name="action_new_quotation" type="object" string="Nuevo"
                        invisible="context.get('emr_history_readonly') or state != 'draft'"
                        help="Crea un presupuesto para este paciente. Elegir el paciente solo muestra la historia clínica. Si esta visita ya tiene presupuesto, abre otra con uno nuevo."/>
            </xpath>
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_view_sale_order" type="object"
                        string="Ver presupuesto" icon="fa-file-text-o"
                        invisible="context.get('emr_history_readonly') or not order_id"
                        help="Abre el turno de esta visita: las prácticas marcadas como A tratar o Tratado ya están cargadas."/>
            </xpath>
            <!-- Cada campo va en su propio grupo: el grupo interno de Odoo
                 es siempre rótulo + valor y no puede partir una fila.
                 Paciente y locación a la izquierda. Turno, corrido unos 5 cm
                 desde el borde derecho, y la fecha a su derecha. Profesional
                 en la misma fila que locación. -->
            <xpath expr="//sheet/group" position="replace">
                <div class="o_emr_odontology_header">
                    <div class="o_emr_header_partner">
                        <group>
                            <field name="partner_id"
                                   readonly="order_id or state != 'draft'"
                                   options="{'no_quick_create': True}"/>
                        </group>
                    </div>
                    <div class="o_emr_header_order">
                        <group>
                            <field name="order_id" readonly="1"/>
                        </group>
                    </div>
                    <div class="o_emr_header_date">
                        <group>
                            <field name="date" readonly="1"/>
                        </group>
                    </div>
                    <div class="o_emr_header_location">
                        <group>
                            <field name="location_id" readonly="1"/>
                        </group>
                    </div>
                    <div class="o_emr_header_practitioner">
                        <group>
                            <field name="practitioner_id"
                                   readonly="order_id or state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="company_id" readonly="1"
                                   groups="base.group_multi_company"/>
                        </group>
                    </div>
                </div>
            </xpath>
            <page name="attachments" position="before">
                <page name="odontology" string="Odontología">
                    <div class="o_emr_odontology_clinical">
                        <group>
                            <field name="reason" placeholder="Motivo de consulta" rows="1"
                                   readonly="state != 'draft'"/>
                            <field name="notes" placeholder="Evolución" rows="1"
                                   readonly="state != 'draft'"/>
                        </group>
                    </div>
                    <field name="line_ids" widget="odontogram_chart" mode="list"
                           nolabel="1" readonly="state != 'draft'">
                        <list limit="1000">
                            <field name="fdi"/>
                            <field name="surface"/>
                            <field name="condition"/>
                            <field name="status"/>
                            <field name="notes"/>
                            <field name="sequence" column_invisible="1"/>
                        </list>
                    </field>
                    <field name="line_ids" readonly="state != 'draft'" nolabel="1">
                        <list editable="bottom" limit="1000">
                            <field name="sequence" widget="handle"/>
                            <field name="fdi"/>
                            <field name="surface"/>
                            <field name="condition"/>
                            <field name="status"/>
                            <field name="notes"/>
                        </list>
                    </field>
                    <field name="diagnosis_ids" widget="many2many_tags"
                           readonly="state != 'draft'"/>
                </page>
            </page>
        </field>
    </record>

    <record id="emr_encounter_odontology_view_list" model="ir.ui.view">
        <field name="name">emr.encounter.odontology.list</field>
        <field name="model">emr.encounter.odontology</field>
        <field name="arch" type="xml">
            <list string="Consultas odontológicas" create="false">
                <field name="date"/>
                <field name="partner_id"/>
                <field name="practitioner_id"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'draft'"
                       decoration-info="state == 'closed'"
                       decoration-success="state == 'signed'"/>
            </list>
        </field>
    </record>

    <record id="emr_encounter_odontology_view_search" model="ir.ui.view">
        <field name="name">emr.encounter.odontology.search</field>
        <field name="model">emr.encounter.odontology</field>
        <field name="arch" type="xml">
            <search string="Consultas odontológicas">
                <field name="partner_id"/>
                <field name="practitioner_id"/>
                <filter name="mine" string="Las mías"
                        domain="[('practitioner_id.user_ids', 'in', [uid])]"/>
                <separator/>
                <filter name="draft" string="En elaboración"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="closed" string="Cerradas"
                        domain="[('state', '=', 'closed')]"/>
                <filter name="signed" string="Firmadas"
                        domain="[('state', '=', 'signed')]"/>
                <separator/>
                <filter name="group_practitioner" string="Profesional"
                        context="{'group_by': 'practitioner_id'}"/>
                <filter name="group_month" string="Mes"
                        context="{'group_by': 'date:month'}"/>
            </search>
        </field>
    </record>

    <record id="emr_encounter_odontology_action" model="ir.actions.act_window">
        <field name="name">Odontología</field>
        <field name="res_model">emr.encounter.odontology</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todavía no hay consultas odontológicas</p>
            <p>
                Se crean al atender un turno de consulta odontológica. El
                odontograma del paciente se actualiza con lo que se anota acá.
            </p>
        </field>
    </record>

    <menuitem id="menu_emr_odontology" name="Odontología"
              parent="emr.menu_emr_atencion"
              action="emr_encounter_odontology_action" sequence="22"
              groups="emr.group_emr_practitioner"/>

    <!-- Sin asistente: Atención abre esta consulta vacía. El paciente se
         elige en el formulario y la historia aparece al costado. El
         presupuesto no existe hasta Nuevo. -->
    <record id="emr_odontology_walkin_action" model="ir.actions.act_window">
        <field name="name">Atención</field>
        <field name="res_model">emr.encounter.odontology</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="emr_encounter_odontology_view_form"/>
        <field name="target">current</field>
        <field name="context">{'form_view_initial_mode': 'edit'}</field>
    </record>

    <menuitem id="menu_emr_odontology_walkin" name="Atender ahora"
              parent="emr.menu_emr_atencion"
              action="emr_odontology_walkin_action" sequence="21"
              groups="emr.group_emr_practitioner"/>

</odoo>
