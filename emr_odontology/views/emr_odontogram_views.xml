<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="emr_odontogram_view_form" model="ir.ui.view">
        <field name="name">emr.odontogram.form</field>
        <field name="model">emr.odontogram</field>
        <field name="arch" type="xml">
            <form string="Odontograma">
                <header>
                    <button name="action_odontology_walkin" type="object"
                            string="Atender ahora" class="btn-primary"
                            invisible="not id"
                            help="Crea el turno y abre una consulta odontológica para este paciente. Lo que marques ahí como práctica pasa solo al presupuesto."/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Estado actual de la boca, uno por paciente. Las consultas
                        lo actualizan al guardarse; también se puede corregir
                        acá. El historial queda en las atenciones, no en este
                        mapa. Lo que se corrige acá no se cobra: para registrar
                        una práctica y que pase al presupuesto, usá
                        <strong>Atender ahora</strong>.
                    </div>
                    <group>
                        <field name="partner_id" readonly="id"/>
                    </group>
                    <field name="tooth_ids" widget="odontogram_chart" mode="list" nolabel="1">
                        <list limit="1000">
                            <field name="fdi"/>
                            <field name="surface"/>
                            <field name="condition"/>
                            <field name="status"/>
                            <field name="notes"/>
                            <field name="last_encounter_id"/>
                        </list>
                    </field>
                    <field name="tooth_ids" nolabel="1">
                        <list editable="bottom" limit="1000">
                            <field name="fdi"/>
                            <field name="surface"/>
                            <field name="condition"/>
                            <field name="status"/>
                            <field name="notes"/>
                            <field name="last_encounter_id" optional="hide"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="emr_odontogram_view_list" model="ir.ui.view">
        <field name="name">emr.odontogram.list</field>
        <field name="model">emr.odontogram</field>
        <field name="arch" type="xml">
            <list string="Odontogramas">
                <field name="partner_id"/>
            </list>
        </field>
    </record>

    <record id="emr_odontogram_view_search" model="ir.ui.view">
        <field name="name">emr.odontogram.search</field>
        <field name="model">emr.odontogram</field>
        <field name="arch" type="xml">
            <search string="Odontogramas">
                <field name="partner_id"/>
            </search>
        </field>
    </record>

    <record id="emr_odontogram_action" model="ir.actions.act_window">
        <field name="name">Odontogramas</field>
        <field name="res_model">emr.odontogram</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Abrir el odontograma de un paciente</p>
            <p>
                Hay uno por paciente. También se abre desde la ficha, y se
                actualiza solo cuando se guarda una consulta odontológica.
            </p>
        </field>
    </record>

    <menuitem id="menu_emr_odontogram" name="Odontogramas"
              parent="emr.menu_emr_atencion"
              action="emr_odontogram_action" sequence="23"
              groups="emr.group_emr_practitioner"/>

    <!-- El mismo listado, para quien administra. No es un catálogo: el
         estado de la boca se carga en Atención. Está acá para encontrarlo
         sin pasar por la ficha del paciente. -->
    <menuitem id="menu_emr_odontogram_config" name="Odontogramas"
              parent="emr.menu_emr_config_section"
              action="emr_odontogram_action" sequence="44"
              groups="emr.group_emr_manager"/>

    <record id="emr_odontogram_condition_view_list" model="ir.ui.view">
        <field name="name">emr.odontogram.condition.list</field>
        <field name="model">emr.odontogram.condition</field>
        <field name="arch" type="xml">
            <list string="Estados de la pieza" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" readonly="id"/>
                <field name="color" placeholder="#fff59d"/>
                <field name="whole_tooth" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="emr_odontogram_condition_view_form" model="ir.ui.view">
        <field name="name">emr.odontogram.condition.form</field>
        <field name="model">emr.odontogram.condition</field>
        <field name="arch" type="xml">
            <form string="Estado de la pieza">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code" readonly="id"/>
                        <field name="color" placeholder="#fff59d"/>
                        <field name="whole_tooth"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <p class="text-muted">
                        El código no se cambia: es el que queda guardado en
                        cada marca. El color es un hexadecimal de seis
                        dígitos, como #fff59d para la corona. Pieza entera
                        pinta todas las caras al elegirlo en la leyenda;
                        si no, se pinta solo la cara seleccionada.
                        Desactivar esconde el estado de la leyenda; las
                        marcas viejas siguen viéndose.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="emr_odontogram_condition_view_search" model="ir.ui.view">
        <field name="name">emr.odontogram.condition.search</field>
        <field name="model">emr.odontogram.condition</field>
        <field name="arch" type="xml">
            <search string="Estados de la pieza">
                <field name="name"/>
                <field name="code"/>
                <filter name="whole_tooth" string="Pieza entera"
                        domain="[('whole_tooth', '=', True)]"/>
                <filter name="inactive" string="Archivados"
                        domain="[('active', '=', False)]"
                        context="{'active_test': False}"/>
            </search>
        </field>
    </record>

    <record id="emr_odontogram_condition_action" model="ir.actions.act_window">
        <field name="name">Estados de la pieza</field>
        <field name="res_model">emr.odontogram.condition</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Definir un estado del odontograma</p>
            <p>
                El nombre y el color salen en la leyenda del mapa. El código
                técnico no se cambia. Pieza entera pinta todas las caras.
            </p>
        </field>
    </record>

    <menuitem id="menu_emr_odontogram_condition" name="Estados de la pieza"
              parent="emr.menu_emr_config_section"
              action="emr_odontogram_condition_action" sequence="45"
              groups="emr.group_emr_manager"/>

    <!-- La columna Estado de cada marca: Presente, A tratar, Tratado,
         Ausente, No erupcionado. No es la leyenda (eso es Estados de la pieza). -->
    <record id="emr_odontogram_status_view_list" model="ir.ui.view">
        <field name="name">emr.odontogram.status.list</field>
        <field name="model">emr.odontogram.status</field>
        <field name="arch" type="xml">
            <list string="Estados de la marca" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" readonly="id"/>
                <field name="billable" readonly="1"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="emr_odontogram_status_view_form" model="ir.ui.view">
        <field name="name">emr.odontogram.status.form</field>
        <field name="model">emr.odontogram.status</field>
        <field name="arch" type="xml">
            <form string="Estado de la marca">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code" readonly="id"/>
                        <field name="sequence"/>
                        <field name="billable" readonly="1"/>
                        <field name="active"/>
                    </group>
                    <p class="text-muted">
                        El nombre es el de la columna Estado del odontograma
                        (Presente, A tratar, Tratado, Ausente, No erupcionado).
                        El color de la leyenda se cambia en Estados de la pieza.
                        El código no se cambia: es el que queda guardado en
                        cada marca. Al presupuesto van los códigos pending y
                        treated, aunque el nombre diga otra cosa. Desactivar
                        esconde la fila de este listado; las marcas viejas
                        siguen mostrando el nombre.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="emr_odontogram_status_view_search" model="ir.ui.view">
        <field name="name">emr.odontogram.status.search</field>
        <field name="model">emr.odontogram.status</field>
        <field name="arch" type="xml">
            <search string="Estados de la marca">
                <field name="name"/>
                <field name="code"/>
                <filter name="inactive" string="Archivados"
                        domain="[('active', '=', False)]"
                        context="{'active_test': False}"/>
            </search>
        </field>
    </record>

    <record id="emr_odontogram_status_action" model="ir.actions.act_window">
        <field name="name">Estados de la marca</field>
        <field name="res_model">emr.odontogram.status</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Definir un estado de la marca</p>
            <p>
                El nombre sale en la columna Estado de cada pieza. El código
                técnico no se cambia: pending y treated siguen yendo al
                presupuesto.
            </p>
        </field>
    </record>

    <menuitem id="menu_emr_odontogram_status" name="Estados de la marca"
              parent="emr.menu_emr_config_section"
              action="emr_odontogram_status_action" sequence="46"
              groups="emr.group_emr_manager"/>

</odoo>
