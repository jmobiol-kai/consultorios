<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Cada cinco minutos, para que la demora configurada se respete con
         alguna precisión: con un cron horario, "quince minutos" serían entre
         quince y setenta y cinco. -->
    <record id="ir_cron_whatsapp_confirmations" model="ir.cron">
        <field name="name">EMR: confirmar turnos por WhatsApp</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_whatsapp_confirmations()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <!-- El recordatorio no necesita precisión de minutos: su disparador es
         "faltan tantas horas", y una vez por hora alcanza. -->
    <record id="ir_cron_whatsapp_reminders" model="ir.cron">
        <field name="name">EMR: recordar turnos por WhatsApp</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_whatsapp_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
